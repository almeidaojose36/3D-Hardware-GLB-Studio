# Copy this file to ".env" (same folder), fill in at least one key, then run:  node studio-server.mjs
# Keys stay on this computer: the studio page never sees them. Never commit your real .env file.

# AI Builder (https://console.anthropic.com): Claude studies your photos, writes the model's procedural
# CAD code and refines it from studio renders. Needs `npm install` once. Billed per use by Anthropic,
# separately from a Claude Pro/Max plan (with a plan, use the Claude Code workflow in the README instead).
ANTHROPIC_API_KEY=
# Optional: the Claude model and effort level the AI Builder uses (defaults shown)
# AI_BUILDER_MODEL=claude-opus-5-5
# AI_BUILDER_EFFORT=high

# Meshy Image-to-3D (https://www.meshy.ai/api), textured PBR models in a few minutes.
# To try the workflow for free, use Meshy's documented test-mode key below; it returns Meshy's sample
# model for every photo and uses no credits:
#   MESHY_API_KEY=msy_dummy_api_key_for_test_mode_12345678
MESHY_API_KEY=

# Stability AI Stable Fast 3D (https://platform.stability.ai), fast single-image reconstruction.
STABILITY_API_KEY=

# Optional server settings
# PORT=8787
# HOST=127.0.0.1
